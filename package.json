{
	"name": "@placemarkio/polyline",
	"version": "2.0.3",
	"description": "encode and decode polylines",
	"scripts": {
		"test": "vitest run",
		"test:ci": "vitest run",
		"lint": "biome check",
		"doc": "typedoc --options ./typedoc.json",
		"prepare": "tsdown"
	},
	"peerDependencies": {
		"@types/geojson": "*"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/placemark/polyline.git"
	},
	"author": "Tom MacWright",
	"license": "MIT",
	"dependencies": {
		"@types/geojson": "^7946.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@changesets/cli": "^2.29.8",
		"husky": "^9.1.7",
		"tsdown": "^0.18.3",
		"typedoc": "^0.28.15",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16"
	},
	"keywords": [
		"polyline",
		"geojson"
	],
	"files": [
		"**/*.js",
		"**/*.mjs",
		"**/*.cjs",
		"**/*.d.ts",
		"**/*.d.mts",
		"**/*.d.cts"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	}
}
